// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model TouchSensor {
  id        Int      @id @default(autoincrement())
  timestamp DateTime  @default(now()) @db.DateTime
  value     Boolean

  @@index([timestamp])
  @@map("touch_sensor")
}

model GPSSensor {
  id           Int       @id @default(autoincrement())
  timestamp    DateTime  @default(now()) @db.DateTime
  latitude     Decimal   @db.Decimal(10, 8)
  longitude    Decimal   @db.Decimal(11, 8)
  latitudeDir  String?   @map("latitude_dir") @db.VarChar(2)
  longitudeDir String?   @map("longitude_dir") @db.VarChar(2)
  fixQuality   String?   @map("fix_quality") @db.VarChar(10)
  satellites   Int?
  hdop         Float?
  altitude     Float?
  speed        Float?
  course       Float?
  date         DateTime? @db.Date

  @@index([timestamp])
  @@index([latitude, longitude])
  @@map("gps_sensor")
}

model DoorSensor {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now()) @db.DateTime
  state     String   @db.VarChar(10)

  @@index([timestamp])
  @@index([state])
  @@map("door_sensor")
}

model TemperatureSensor {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now()) @db.DateTime
  temperature Float

  @@index([timestamp])
  @@index([temperature])
  @@map("temperature_sensor")
}

model Alert {
  id          Int       @id @default(autoincrement())
  timestamp   DateTime  @default(now()) @db.DateTime
  alertType   String    @map("alert_type") @db.VarChar(20)
  severity    String    @default("medium") @db.VarChar(10)
  description String    @db.Text
  resolved    Boolean   @default(false)
  resolvedAt  DateTime? @map("resolved_at") @db.DateTime

  @@index([timestamp])
  @@index([alertType])
  @@index([severity])
  @@index([resolved])
  @@map("alerts")
}

